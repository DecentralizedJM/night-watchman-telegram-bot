# Night Watchman Environment Variables

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin Chat ID (where spam reports are sent - your personal chat ID)
ADMIN_CHAT_ID=395803228

# OpenAI GPT (spam detection brain)
OPENAI_API_KEY=your_openai_api_key_here
GPT_ENABLED=true
GPT_MODEL=gpt-4o-mini
GPT_RPM_LIMIT=30
